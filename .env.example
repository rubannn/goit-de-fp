# Filled with random URL-safe passwords by scripts/setup.py. Never commit .env.
MYSQL_ROOT_PASSWORD=
MYSQL_USER=airflow
MYSQL_PASSWORD=

# Container addresses; for the supplied remote DB replace source settings only.
SOURCE_MYSQL_HOST=mysql
SOURCE_MYSQL_PORT=3306
SOURCE_MYSQL_DATABASE=olympic_dataset
SOURCE_MYSQL_USER=airflow
SOURCE_MYSQL_PASSWORD=
OUTPUT_MYSQL_HOST=mysql
OUTPUT_MYSQL_PORT=3306
OUTPUT_MYSQL_DATABASE=olympic_results
OUTPUT_MYSQL_USER=airflow
OUTPUT_MYSQL_PASSWORD=
OUTPUT_MYSQL_TABLE=athlete_avg_stats
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_JAAS_CONFIG=
KAFKA_INPUT_TOPIC=athlete_event_results
KAFKA_OUTPUT_TOPIC=athlete_avg_stats
DATA_ROOT=/opt/airflow/project/data
CHECKPOINT_ROOT=/opt/airflow/project/checkpoints
